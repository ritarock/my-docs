---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const posts = (await getCollection("docs")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
---

<Layout>
  <nav class="tag-list">
    <span class="tag-label">Tags:</span>
    {tags.map((tag: string) => (
      <a class="tag" href={`/tags/${tag}`}>#{tag}</a>
    ))}
  </nav>
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <span class="date">{post.data.pubDate.toISOString().slice(0, 10)}:</span> <a href={`/docs/${post.id}`}>{post.data.title}</a>
        {post.data.tags.map((tag: string) => (
          <a class="tag" href={`/tags/${tag}`}>#{tag}</a>
        ))}
      </li>
    ))}
  </ul>
</Layout>

<style>
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-list li {
    padding: 0.1rem 0;
  }

  .post-list a:not(.tag) {
    text-decoration: underline;
    color: #6b9bd2;
    font-weight: 500;
  }

  .post-list a:not(.tag):hover,
  .post-list a:not(.tag):visited,
  .post-list a:not(.tag):active {
    color: #6b9bd2;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid #e0e0e0;
    font-size: 0.75rem;
  }

  .tag-label {
    font-size: 0.75rem;
    color: #888;
    font-weight: 600;
    width: 100%;
  }

  .date {
    font-variant-numeric: tabular-nums;
    font-feature-settings: "tnum";
  }

  .tag {
    font-size: 0.75rem;
    color: #555;
    background-color: #f0f0f0;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    margin-left: 0.3rem;
    text-decoration: none;
    font-weight: normal;
  }

  .tag:hover {
    background-color: #e4e4e4;
    color: #555;
  }

  .tag:visited {
    color: #555;
  }
</style>
