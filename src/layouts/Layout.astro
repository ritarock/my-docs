---
interface Props {
  title?: string;
  description?: string;
}

const { title = "my-docs", description = "my-docs" } = Astro.props;
const siteTitle = "my-docs";
const pageTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="container">
      <header class="header">
        <a href="/" class="header-title">{siteTitle}</a>
      </header>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family:
      -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue",
      Arial, sans-serif;
    line-height: 1.7;
    color: #333;
    background-color: #fafafa;
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0;
    padding-bottom: 0;
  }

  .header-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #111;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 1.5rem;
  }

  nav a {
    color: #555;
    text-decoration: none;
    font-size: 0.9rem;
  }

  nav a:hover {
    color: #111;
  }

  main {
    flex: 1;
    padding: 1rem 0;
  }

</style>
