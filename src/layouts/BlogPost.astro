---
import Layout from "./Layout.astro";

interface Props {
  title: string;

  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
}

const { title, pubDate, updatedDate, tags = [] } = Astro.props;

function formatDate(date: Date): string {
  return date.toISOString().slice(0, 10);
}
---

<Layout title={title}>
  <article class="post">
    <header class="post-header">
      <h1>{title}</h1>
      <div class="post-meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && (
          <span class="updated">
            (更新: <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>)
          </span>
        )}
      </div>
      {tags.length > 0 && (
        <div class="tags">
          {tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
    </header>
    <div class="post-content">
      <slot />
    </div>
    <footer class="post-footer">
      <a href="/">&larr; 一覧に戻る</a>
    </footer>
  </article>
</Layout>

<style>
  .post-header {
    margin-bottom: 2rem;
  }

  .post-header h1 {
    font-size: 2rem;
    font-weight: 700;
    color: #111;
    line-height: 1.3;
    margin-bottom: 0.75rem;
  }

  .post-meta {
    font-size: 0.9rem;
    color: #888;
  }

  .updated {
    margin-left: 0.5rem;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.75rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.8rem;
    background-color: #f0f0f0;
    color: #555;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }

  .post-content {
    font-size: 1rem;
    line-height: 1.85;
    color: #333;
  }

  .post-content :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: #111;
  }

  .post-content :global(h3) {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: #222;
  }

  .post-content :global(p) {
    margin-bottom: 1.25rem;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.4rem;
  }

  .post-content :global(code) {
    font-family: "SF Mono", "Fira Code", "Fira Mono", Menlo, monospace;
    font-size: 0.9em;
    background-color: #f5f5f5;
    padding: 0.15rem 0.35rem;
    border-radius: 3px;
  }

  .post-content :global(pre) {
    background-color: #1e1e1e;
    color: #d4d4d4;
    padding: 1.25rem;
    border-radius: 6px;
    overflow-x: auto;
    margin-bottom: 1.25rem;
  }

  .post-content :global(pre code) {
    background: none;
    padding: 0;
    font-size: 0.85rem;
  }

  .post-content :global(blockquote) {
    border-left: 3px solid #ddd;
    padding-left: 1rem;
    color: #666;
    margin-bottom: 1.25rem;
  }

  .post-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e0e0e0;
  }

  .post-footer a {
    color: #555;
    text-decoration: none;
    font-size: 0.9rem;
  }

  .post-footer a:hover {
    color: #111;
  }
</style>
